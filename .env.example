# Copy to .env.local and fill in. Never commit real keys.

# Required for live analysis via /api/* routes (OpenAI).
# Without it the API routes return an error; the built-in sample still works.
OPENAI_API_KEY=

# Optional: override the model (default: gpt-5-mini).
# OPENAI_MODEL=

# Optional: absolute site URL used for metadata / Open Graph images.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
